{
  "name": "guided-review",
  "private": true,
  "type": "module",
  "description": "builds and serves a guided review page; self-contained, with no tie to whichever repo is being reviewed",
  "scripts": {
    "build": "node build.ts",
    "serve": "node serve.ts",
    "check:type": "tsc --noEmit",
    "test:e2e": "node test/e2e.mjs"
  },
  "dependencies": {
    "@headless-tree/core": "1.7.0",
    "@headless-tree/react": "1.7.0",
    "chokidar": "^5.0.0",
    "preact": "11.0.0-beta.1",
    "react-resizable-panels": "^3.0.6",
    "snarkdown-in-react": "2.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "bootstrap-icons": "1.13.1",
    "monaco-editor": "0.52.2",
    "playwright": "1.61.1",
    "typescript": "^5.9.2",
    "vite": "^8.0.13"
  }
}
